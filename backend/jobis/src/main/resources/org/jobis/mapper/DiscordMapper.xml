<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jobis.mapper.DiscordMapper">
	<select id="getNicknameByUno" resultType="String" parameterType="int">
		SELECT nickname
		FROM TBL_UPROFILE
		WHERE uno = #{uno}
	</select>
</mapper>